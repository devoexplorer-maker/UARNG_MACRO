def sample(x, y):
    try: return ImageGrab.grab(bbox=(x, y, x+1, y+1)).getpixel((0, 0))[:3]
    except Exception: return (0, 0, 0)

def color_close(a, b, tol):
    return all(abs(int(a[i]) - int(b[i])) <= tol for i in range(3))

def get_roblox_rect():
    """(x, y, w, h) of the Roblox client area in screen coords, or None."""
    try:
        hwnd = user32.FindWindowW(None, "Roblox")
        if not hwnd: return None
        class RECT(ctypes.Structure):
            _fields_ = [("l",ctypes.c_long),("t",ctypes.c_long),("r",ctypes.c_long),("b",ctypes.c_long)]
        class PT(ctypes.Structure):
            _fields_ = [("x",ctypes.c_long),("y",ctypes.c_long)]
        rc = RECT(); user32.GetClientRect(hwnd, ctypes.byref(rc))
        pt = PT(); user32.ClientToScreen(hwnd, ctypes.byref(pt))
        if rc.r <= 0 or rc.b <= 0: return None
        return (pt.x, pt.y, rc.r, rc.b)
    except Exception:
        return None

def roblox_focused():
    try:
        buf = ctypes.create_unicode_buffer(256)
        user32.GetWindowTextW(user32.GetForegroundWindow(), buf, 256)
        return "roblox" in buf.value.lower()
    except Exception:
        return False

def resolve_point(cfg, key):
    """Window-relative point if saved that way and Roblox is open, else absolute."""
    frac = cfg.get("_frac", {}).get(key)
    if frac:
        rect = get_roblox_rect()
        if rect:
            rx, ry, rw, rh = rect
            return (int(rx + frac[0]*rw), int(ry + frac[1]*rh))
    p = cfg.get(key)
    return tuple(p) if p else None

def resolve_box(cfg, key):
    frac = cfg.get("_frac", {}).get(key)
    if frac:
        rect = get_roblox_rect()
        if rect:
            rx, ry, rw, rh = rect
            return (int(rx + frac[0]*rw), int(ry + frac[1]*rh), int(frac[2]*rw), int(frac[3]*rh))
    b = cfg.get(key)
    return tuple(b) if b else None

# ── REEL BAR VISION ────────────────────────────────────────────
# Track = very dark bar. Green zone = the green block you control.
# Fish  = the blue fish icon you have to keep inside the green zone.
def _is_green(c): return c[1] > 90 and c[1] > c[0] + 30 and c[1] > c[2] + 15
def _is_fish(c):  return c[2] > 140 and c[2] > c[0] + 40 and c[2] >= c[1]
def _is_dark(c):  return c[0] < 60 and c[1] < 60 and c[2] < 70

try:
    import numpy as _np
    _NP_OK = True
except ImportError:
    _NP_OK = False

def _empty(W): return {"active": False, "W": W, "g0": None, "g1": None, "fish": None}

def analyze_img(img, band=False):
    """Return {'active', 'W', 'g0', 'g1', 'fish'} for a crop of the reel track.
    'active' = the track is on screen (dark bar + a green zone and/or the fish).
    g0/g1 may be None when a big fish (whale) covers the whole green zone."""
    img = img.convert("RGB"); W, H = img.size
    res = _empty(W)
    if W < 10 or H < 3: return res
    y0, y1 = (0, H) if band else (int(H*0.2), max(int(H*0.2)+1, int(H*0.8)))
    if _NP_OK:
        # Every pixel column, every row in the middle band — pixel-exact and fast.
        a = _np.asarray(img, dtype=_np.int16)[y0:y1]
        r, g, b = a[..., 0], a[..., 1], a[..., 2]
        green = (g > 90) & (g > r + 30) & (g > b + 15)
        fish  = (b > 140) & (b > r + 40) & (b >= g) & ~green
        dark  = (r < 60) & (g < 60) & (b < 70)
        gcols = _np.nonzero(green.sum(axis=0) >= 2)[0]
        fcnt  = fish.sum(axis=0)
        dfrac = dark.mean()
        gx = gcols.tolist()
        fx_ok = fcnt.sum() >= 4
        fish_x = float((fcnt * _np.arange(W)).sum() / fcnt.sum()) if fx_ok else None
    else:
        px = img.load(); ystep = max(1, (y1-y0)//7)
        gx, fxs = [], []; dark = total = 0
        for x in range(W):
            gc = 0
            for y in range(y0, y1, ystep):
                c = px[x, y]; total += 1
                if _is_green(c): gc += 1
                elif _is_fish(c): fxs.append(x)
                elif _is_dark(c): dark += 1
            if gc: gx.append(x)
        dfrac = dark/total if total else 0
        fish_x = sum(fxs)/len(fxs) if len(fxs) >= 4 else None
    if dfrac < 0.05: return res
    if len(gx) >= 3:
        res["active"] = True; res["g0"], res["g1"] = gx[0], gx[-1]
        res["fish"] = fish_x
    elif fish_x is not None and dfrac >= 0.25:
        # Fish on a dark track but no green visible: zone is hidden under a big
        # fish. Only trusted by the engine while a reel is already in progress.
        res["fish_only"] = True; res["fish"] = fish_x
    return res

def grab_box(bx, by, bw, bh):
    if _MSS_OK:
        sct = getattr(_tls, "sct", None)
        if sct is None:
            sct = _mss.mss(); _tls.sct = sct   # one instance per thread (mss isn't thread-safe)
        raw = sct.grab({"left": bx, "top": by, "width": bw, "height": bh})
        return Image.frombytes("RGB", raw.size, raw.bgra, "raw", "BGRX")
    return ImageGrab.grab(bbox=(bx, by, bx+bw, by+bh))

def analyze_box(box):
    bx, by, bw, bh = box
    y0 = int(bh*0.2); h = max(1, int(bh*0.8) - y0)
    try: img = grab_box(bx, by + y0, bw, h)      # middle band only
    except Exception: return _empty(bw)
    return analyze_img(img, band=True)

def _slopes(hist, now, win):
    """Least-squares speed (px/s) of zone centre and fish over the last `win` sec.
    A line fit over many samples is far less jumpy than frame-to-frame differences."""
    pts = [h for h in hist if now - h[0] <= win]
    if len(pts) < 3: return 0.0, 0.0
    t0 = pts[0][0]; ts = [p[0]-t0 for p in pts]; mt = sum(ts)/len(ts)
    den = sum((t-mt)**2 for t in ts) or 1e-9
    def sl(i):
        ys = [p[i] for p in pts]; my = sum(ys)/len(ys)
        return sum((t-mt)*(y-my) for t, y in zip(ts, ys)) / den
    return sl(1), sl(2)

