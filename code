# ── ENGINE ─────────────────────────────────────────────────────
class Engine:
    def __init__(self):
        self.running = False; self.cfg = None
        self.log_cb = self.status_cb = self.stats_cb = None
        self.catches = 0

    def log(self, m):
        if self.log_cb: self.log_cb(m)

    def start(self, cfg):
        if self.running: return
        self.cfg = cfg; self.running = True; self.catches = 0
        if self.stats_cb: self.stats_cb(0)
        if not cfg.get("reel_box"):
            self.log("⚠ Reel bar not set — open SETUP and snap it first!")
        if not cfg.get("stop_btn"):
            self.log("⚠ Stop button not set — using slow timer recasts")
        threading.Thread(target=self._fish_loop, daemon=True).start()
        if cfg.get("sounds_enabled", True): play_sound("start")
        if self.status_cb: self.status_cb(True)

    def stop(self):
        was = self.running; self.running = False
        try: keyboard.release("e")
        except Exception: pass
        if was and self.cfg and self.cfg.get("sounds_enabled", True): play_sound("stop")
        if self.status_cb: self.status_cb(False)

    def _tap_e(self, hold=0.07):
        keyboard.press("e"); time.sleep(hold); keyboard.release("e")

    def _fish_loop(self):
        cfg = self.cfg
        holding = False
        def hold(on):
            nonlocal holding
            if on and not holding:   keyboard.press("e");   holding = True
            elif not on and holding: keyboard.release("e"); holding = False

        reeling = False; reel_start = 0.0; lost_since = None
        last_cast = 0.0; last_reel_end = 0.0
        hist = collections.deque(maxlen=40)     # (t, zone_centre, fish_x)
        last_fish = None; vz = vf = 0.0
        last_focus_warn = 0.0; last_dbg = 0.0
        self.log("=== FISHING STARTED ===")

        while self.running:
            try:
                now = time.time()
                if not roblox_focused():
                    hold(False)
                    if now - last_focus_warn > 5:
                        self.log("Waiting — click into Roblox so it's the focused window")
                        last_focus_warn = now
                    time.sleep(0.25); continue

                box = resolve_box(cfg, "reel_box")
                r = analyze_box(box) if box else _empty(0)
                seen = r["active"] or (reeling and r.get("fish_only"))

                # A single bad frame (flash, whale covering the zone, frame tear)
                # must not end the reel and drop E mid-fight.
                if reeling and not seen:
                    if lost_since is None: lost_since = now
                    if now - lost_since < 0.3:
                        time.sleep(0.004); continue
                else:
                    lost_since = None

                # ── REELING ──
                if seen:
                    if not reeling:
                        reeling = True; reel_start = now
                        hist.clear(); last_fish = None; vz = vf = 0.0
                        self.log(">> Bite! Reeling...")
                    if now - reel_start > float(cfg.get("max_reel", 90)):
                        hold(False); self.log("Reel ran too long — letting go")
                        reel_start = now; time.sleep(1.0); continue

                    mode = cfg.get("reel_mode", "track")
                    if mode == "hold":
                        hold(True)
                    elif mode == "tap":
                        hold(True); time.sleep(0.05); hold(False)
                        time.sleep(float(cfg.get("tap_gap", 0.12)))
                    else:
                        # PD control on the gap between fish and zone centre, plus how
                        # fast that gap is changing (line-fit over the last 50 ms), so it
                        # brakes before sliding past the fish.
                        W = r["W"]
                        fish = r["fish"] if r["fish"] is not None else last_fish
                        zc = (r["g0"] + r["g1"]) / 2.0 if r["g0"] is not None else fish  # zone hidden under fish => on target
                        if fish is not None and zc is not None:
                            last_fish = fish
                            hist.append((now, zc, fish))
                            vz, vf = _slopes(hist, now, 0.05)
                            ve = vf - vz
                            u = (fish - zc) + float(cfg.get("track_kd", 0.35)) * ve
                            db = float(cfg.get("track_dead", 0.0)) * W
                            if u > db:    want = True           # zone needs to go right
                            elif u < -db: want = False          # zone needs to go left
                            else:         want = ve > 0         # on target: lean with the fish
                            if cfg.get("invert", False): want = not want
                            hold(want)
                            if now - last_dbg > 1.0:
                                self.log(f"  gap {fish - zc:+.0f}px  zone {vz:+.0f}  fish {vf:+.0f}px/s  E={'held' if holding else 'up'}")
                                last_dbg = now
                    time.sleep(0.002)
                    continue

                # ── NOT REELING ──
                hold(False)
                if reeling:
                    reeling = False; last_reel_end = now
                    dur = now - reel_start
                    if dur >= 0.6:
                        self.catches += 1
                        if self.stats_cb: self.stats_cb(self.catches)
                        if cfg.get("sounds_enabled", True): play_sound("catch")
                        self.log(f">> Reel finished ({dur:.1f}s) — #{self.catches}")

                stop_pt = resolve_point(cfg, "stop_btn"); stop_rgb = cfg.get("stop_rgb")
                calibrated = bool(stop_pt and stop_rgb)
                if calibrated and color_close(sample(*stop_pt), stop_rgb, int(cfg.get("color_tol", 45))):
                    time.sleep(0.08); continue          # "Waiting for a bite" is up — just wait

                post_ok = now - last_reel_end >= float(cfg.get("post_catch", 1.5))
                if calibrated:
                    ready = post_ok and now - last_cast >= float(cfg.get("cast_cd", 2.5))
                else:
                    just_caught = last_reel_end > last_cast
                    ready = (post_ok and just_caught) or now - last_cast >= float(cfg.get("recast_timeout", 30))
                if ready:
                    self._tap_e(); last_cast = now
                    self.log(">> Cast (E)")
                time.sleep(0.1)
            except Exception as e:
                hold(False); self.log(f"Error: {e}"); time.sleep(0.5)
        hold(False)
        self.log("=== STOPPED ===")

