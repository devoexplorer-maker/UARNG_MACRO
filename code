    # ── HOTKEY CAPTURE ──
    def _hotkey_row(self, parent, label, key):
        r = tk.Frame(parent, bg=self.CARD); r.pack(fill="x", pady=2)
        self._lbl(r, label, size=9, width=14, anchor="w").pack(side="left")
        var = tk.StringVar(value=self.cfg.get(key, "")); self._v[key] = (var, str)
        lbl = tk.Label(r, textvariable=var, bg=self.ENT, fg=self.FG, font=("Consolas", 10), width=10, cursor="hand2",
                       highlightthickness=1, highlightbackground="#2a2a35")
        lbl.pack(side="right"); lbl.bind("<Button-1>", lambda e, v=var, l=lbl, k=key: self._listen(v, l, k))

    def _listen(self, var, lbl, key):
        self._cancel_listen(); self._lv, self._ll, self._lk = var, lbl, key
        lbl.config(fg=self.ACC2, highlightbackground=self.ACC2); var.set("Press a key...")
        self._kh = keyboard.on_press(self._got_key, suppress=False); return "break"

    def _got_key(self, event):
        if not self._lv: return
        name = (event.name or "").lower()
        self._lv.set(name); self.cfg[self._lk] = name
        if self._ll: self._ll.config(fg=self.FG, highlightbackground="#2a2a35")
        try: keyboard.unhook(self._kh)
        except Exception: pass
        self._lv = self._ll = self._lk = None
        self.after(100, self._rebind)

    def _cancel_listen(self):
        if not self._lv: return
        self._lv.set(self.cfg.get(self._lk, ""))
        if self._ll: self._ll.config(fg=self.FG, highlightbackground="#2a2a35")
        try: keyboard.unhook(self._kh)
        except Exception: pass
        self._lv = self._ll = self._lk = None

    def _unfocus(self, event):
        w = event.widget
        if isinstance(w, (tk.Entry, tk.Spinbox, ttk.Combobox)): return
        if any(s in str(w.winfo_class()).lower() for s in ("combobox", "popdown", "listbox")): return
        try: self.focus_set()
        except Exception: pass

    def _rebind(self):
        """One low-level global hook sets flags; actions run on the main thread."""
        s = self._gather()
        self._hk = {k: kbd_key(s.get(f"{k}_key", DEFAULTS[f"{k}_key"])) for k in ("start", "stop", "close", "snap")}
        try:
            if self._global_hook is not None: keyboard.unhook(self._global_hook)
        except Exception: pass
        def _on_event(e):
            try:
                if getattr(e, "event_type", None) != "down" or self._lv: return
                nm = (e.name or "").lower()
                if   nm == self._hk["start"]: self._hk_flags["start"] = True
                elif nm == self._hk["stop"]:  self._hk_flags["stop"]  = True
                elif nm == self._hk["close"]: self._hk_flags["close"] = True
                elif nm == self._hk["snap"] and self._snap_armed: self._hk_flags["snap"] = True
            except Exception: pass
        try:
            self._global_hook = keyboard.hook(_on_event)
            self._log(f"Hotkeys → start '{self._hk['start']}'  stop '{self._hk['stop']}'  close '{self._hk['close']}'  snap '{self._hk['snap']}'")
        except Exception as ex:
            self._log(f"Hotkey hook FAILED: {ex}")

    def _poll_hotkeys(self):
        f = self._hk_flags
        try:
            if f["start"]: f["start"] = False; self._toggle()
            if f["stop"]:
                f["stop"] = False
                if self.eng.running: self.eng.stop()
            if f["snap"]: f["snap"] = False; self._do_snap()
            if f["close"]: f["close"] = False; self._close(); return
        except Exception: pass
        self.after(40, self._poll_hotkeys)

    # ── CALIBRATION ──
    def _pick_stop(self):
        if self._picking: return
        self._picking = True
        lab = self._setup_rows["stop_btn"]
        self._log("Hover the RED part of the Stop button — capturing in 3s...")
        for i, txt in enumerate(("3...", "2...", "1...")):
            self.after(i*1000, lambda t=txt: lab.config(text=t, fg=self.ACC2))
        self.after(3000, self._do_pick_stop)

    def _do_pick_stop(self):
        self._picking = False
        import ctypes.wintypes as wt
        pt = wt.POINT(); user32.GetCursorPos(ctypes.byref(pt))
        x, y = pt.x, pt.y; c = sample(x, y)
        lab = self._setup_rows["stop_btn"]
        if not (c[0] > 150 and c[0] > c[1] + 50 and c[0] > c[2] + 40):
            lab.config(text=f"not red {c} — retry", fg=self.DIM)
            self._log(f"That pixel isn't red {c}. Hover the red button background, not the white text.")
            return
        self.cfg["stop_btn"] = [x, y]; self.cfg["stop_rgb"] = list(c)
        rect = get_roblox_rect()
        if rect:
            rx, ry, rw, rh = rect
            self.cfg.setdefault("_frac", {})["stop_btn"] = [(x-rx)/rw, (y-ry)/rh]
            note = "window-relative"
        else:
            self.cfg.setdefault("_frac", {}).pop("stop_btn", None); note = "absolute (Roblox window not found)"
        save_cfg(self.cfg)
        lab.config(text=f"set {c}", fg=self.ACC)
        self._log(f"Stop button saved at ({x},{y}) colour {c} [{note}]")

    def _arm_snap(self):
        self._snap_armed = True
        self._setup_rows["reel_box"].config(text=f"press {self._hk['snap'].upper()} on the bite", fg=self.ACC2)
        self._log(f"Armed — go fish. When the reel bar appears, press {self._hk['snap'].upper()}.")

    def _do_snap(self):
        self._snap_armed = False
        try: img = ImageGrab.grab()
        except Exception as e:
            self._log(f"Screenshot failed: {e}"); return
        self._open_box_drawer(img)

    def _open_box_drawer(self, img):
        W, H = img.size
        ov = tk.Toplevel(self); ov.overrideredirect(True); ov.attributes("-topmost", True)
        ov.geometry(f"{W}x{H}+0+0")
        cv = tk.Canvas(ov, width=W, height=H, highlightthickness=0, cursor="crosshair"); cv.pack()
        tkimg = ImageTk.PhotoImage(img); ov._img = tkimg
        cv.create_image(0, 0, anchor="nw", image=tkimg)
        cv.create_rectangle(W//2-470, 12, W//2+470, 60, fill="#000000", outline=self.ACC, width=2)
        cv.create_text(W//2, 36, fill="white", font=("Consolas", 13, "bold"),
                       text="Drag a TIGHT box around the dark reel bar (green zone + fish).  Release = save  •  Esc = cancel")
        st = {"x0": None, "y0": None, "rect": None}
        def press(e):
            st["x0"], st["y0"] = e.x, e.y
            if st["rect"]: cv.delete(st["rect"])
            st["rect"] = cv.create_rectangle(e.x, e.y, e.x, e.y, outline="#ff3344", width=2)
        def drag(e):
            if st["rect"] is not None: cv.coords(st["rect"], st["x0"], st["y0"], e.x, e.y)
        def release(e):
            if st["x0"] is None: return
            x1, y1 = min(st["x0"], e.x), min(st["y0"], e.y)
            x2, y2 = max(st["x0"], e.x), max(st["y0"], e.y)
            ov.destroy()
            if x2-x1 < 30 or y2-y1 < 6:
                self._log("Box too small — click Snap Reel Bar and try again"); return
            self._save_reel_box(x1, y1, x2-x1, y2-y1, img.crop((x1, y1, x2, y2)))
        def cancel(e=None):
            ov.destroy(); self._setup_rows["reel_box"].config(text="cancelled", fg=self.DIM)
        cv.bind("<ButtonPress-1>", press); cv.bind("<B1-Motion>", drag); cv.bind("<ButtonRelease-1>", release)
        ov.bind("<Escape>", cancel); ov.focus_force()
        try: ov.grab_set()
        except Exception: pass

    def _save_reel_box(self, x, y, w, h, crop):
        self.cfg["reel_box"] = [x, y, w, h]
        rect = get_roblox_rect()
        if rect:
            rx, ry, rw, rh = rect
            self.cfg.setdefault("_frac", {})["reel_box"] = [(x-rx)/rw, (y-ry)/rh, w/rw, h/rh]
            note = "window-relative"
        else:
            self.cfg.setdefault("_frac", {}).pop("reel_box", None); note = "absolute"
        save_cfg(self.cfg)
        r = analyze_img(crop)
        if r["active"]:
            self._setup_rows["reel_box"].config(text=f"set {w}x{h} ✓", fg=self.ACC)
            fish = f"fish at {r['fish']}" if r["fish"] is not None else "fish NOT seen (ok if it was inside the zone)"
            self._log(f"Reel bar saved {w}x{h} [{note}] — green {r['g0']}-{r['g1']} of {r['W']}, {fish}")
        else:
            self._setup_rows["reel_box"].config(text=f"set {w}x{h} (?)", fg=self.ACC2)
            self._log("Saved, but no green zone found in that box — make sure it covers the dark bar while the bite is up.")

    def _test_detect(self):
        box = resolve_box(self.cfg, "reel_box")
        if box:
            r = analyze_box(box)
            self._log(f"Reel bar: {'ACTIVE' if r['active'] else 'not visible'}  zone {r['g0']}-{r['g1']}  fish {r['fish']}")
        else:
            self._log("Reel bar not set")
        pt = resolve_point(self.cfg, "stop_btn"); rgb = self.cfg.get("stop_rgb")
        if pt and rgb:
            c = sample(*pt); ok = color_close(c, rgb, int(self._gather().get("color_tol", 45)))
            self._log(f"Stop button: {c} vs saved {tuple(rgb)} → {'WAITING FOR BITE' if ok else 'not showing'}")
        else:
            self._log("Stop button not set")

    def _startup_checks(self):
        if not self.cfg.get("reel_box") or not self.cfg.get("stop_btn"):
            self._log("⚠ Not fully set up — open SETUP below.")
        else:
            self._log("Ready. Click into Roblox at a fishing spot and press START.")

    # ── SETTINGS ──
    def _gather(self):
        s = dict(self.cfg)
        for k, (var, cast) in self._v.items():
            try:
                val = var.get()
                s[k] = val.strip() if isinstance(val, str) and cast is str else cast(val)
            except Exception: pass
        s["overlay_opacity"] = self._ov_opacity.get() if hasattr(self, "_ov_opacity") else s.get("overlay_opacity", 0.88)
        s["ui_theme"] = self._theme_var.get() if hasattr(self, "_theme_var") else s.get("ui_theme", "default")
        return s

    def _save(self):
        self.cfg = self._gather(); save_cfg(self.cfg)
        if self.eng.running: self.eng.cfg.update(self.cfg)
        self._log("Settings saved."); self._rebind()

    def _toggle(self):
        if self.eng.running: self.eng.stop()
        else:
            self.cfg = self._gather(); self.eng.start(self.cfg)

    def _change_theme(self, e=None):
        import tkinter.messagebox as mb
        self.cfg["ui_theme"] = self._theme_var.get(); save_cfg(self.cfg)
        mb.showinfo("Theme Changed", f"Theme set to '{self.cfg['ui_theme']}'\nRestart to apply.", parent=self)

    # ── LOGGING (thread-safe queue) ──
    def _log(self, msg):
        self._log_lines.append(msg); self._log_pending.append(msg)

    def _drain_logs(self):
        try:
            last = None; n = 0
            while self._log_pending and n < 150:
                last = self._log_pending.popleft(); n += 1
                if self._log_open:
                    self._log_panel.config(state="normal"); self._log_panel.insert("end", last + "\n")
                    self._log_panel.config(state="disabled")
            if last is not None:
                self._status_line.config(text=last[:48])
                if self._log_open:
                    lines = int(self._log_panel.index('end-1c').split('.')[0])
                    if lines > 400:
                        self._log_panel.config(state="normal"); self._log_panel.delete("1.0", f"{lines-300}.0")
                        self._log_panel.config(state="disabled")
                    self._log_panel.see("end")
                if self._overlay and self._overlay.winfo_exists():
                    self._ov_action.config(text=last[:38])
        except Exception: pass
        self.after(80, self._drain_logs)

    def _toggle_log(self):
        if self._log_open:
            self._log_panel.pack_forget(); self._log_open = False
        else:
            self._log_panel.pack(fill="x", padx=20, pady=(0, 6), after=self._status_card); self._log_open = True
            self._log_panel.config(state="normal"); self._log_panel.delete("1.0", "end")
            for line in list(self._log_lines)[-100:]: self._log_panel.insert("end", line + "\n")
            self._log_panel.see("end"); self._log_panel.config(state="disabled")
        self._draw_log_icon()

    # ── STATUS / STATS ──
    def _set_status(self, active):
        def _do():
            if active:
                self._dot.config(fg=self.ACC); self._slbl.config(fg=self.FG, text="  FISHING")
                self._btn.config(text="STOP", bg="#333340"); self._session_start = self._session_start or time.time()
            else:
                self._dot.config(fg="#2a2a35"); self._slbl.config(fg=self.DIM, text="  OFFLINE")
                self._btn.config(text="START", bg=self.ACC); self._session_start = None
            if self._overlay and self._overlay.winfo_exists():
                col = self.ACC if active else self.DIM
                self._ov_dot.config(fg=col); self._ov_lbl.config(text="FISHING" if active else "OFFLINE", fg=col)
                self._ov_toggle.config(text="STOP" if active else "START", bg=self.CARD if active else self.ACC)
        self.after(0, _do)

    def _set_catches(self, n):
        self._catch_count = n   # read by _tick_session on the main thread

    def _tick_session(self):
        if self.eng.running and self._session_start:
            m, s = divmod(int(time.time() - self._session_start), 60); h, m = divmod(m, 60)
            self._session_lbl.config(text=f"⏱ {h}:{m:02d}:{s:02d}" if h else f"⏱ {m}:{s:02d}")
        else:
            self._session_lbl.config(text="")
        self._catch_lbl.config(text=f"🐟 {self._catch_count}")
        if self._overlay and self._overlay.winfo_exists():
            self._ov_catch.config(text=f"🐟 {self._catch_count}")
        self.after(500, self._tick_session)

    # ── OVERLAY ──
    def _update_ov_opacity(self, val=None):
        if self._overlay and self._overlay.winfo_exists():
            self._overlay.attributes("-alpha", self._ov_opacity.get())

    def _toggle_overlay(self):
        if self._overlay and self._overlay.winfo_exists():
            self.cfg["overlay_x"] = self._overlay.winfo_x(); self.cfg["overlay_y"] = self._overlay.winfo_y()
            self._overlay.destroy(); self._overlay = None; self._overlay_btn.config(bg=self.ACC); return
        B, A, D, C = self.BG, self.ACC, self.DIM, self.CARD
        ov = tk.Toplevel(self); ov.overrideredirect(True); ov.attributes("-topmost", True)
        ov.attributes("-alpha", self._ov_opacity.get())
        x = max(0, min(self.cfg.get("overlay_x", 20), self.winfo_screenwidth() - 60))
        y = max(0, min(self.cfg.get("overlay_y", 20), self.winfo_screenheight() - 60))
        ov.geometry(f"+{x}+{y}"); ov.config(bg=B)
        ov._dx = ov._dy = 0
        def ds(e): ov._dx, ov._dy = e.x, e.y
        def dm(e): ov.geometry(f"+{ov.winfo_x()+e.x-ov._dx}+{ov.winfo_y()+e.y-ov._dy}")
        def drag(w): w.bind("<ButtonPress-1>", ds); w.bind("<B1-Motion>", dm)
        tk.Frame(ov, bg=A, height=2).pack(fill="x")
        top = tk.Frame(ov, bg=B); top.pack(fill="x", padx=6, pady=(3, 0)); drag(top)
        t = tk.Label(top, text=f"{APP_TITLE}  {VERSION}", bg=B, fg=D, font=("Consolas", 7, "bold")); t.pack(side="left"); drag(t)
        cl = tk.Label(top, text="✕", bg=B, fg=D, font=("Consolas", 9), cursor="hand2"); cl.pack(side="right")
        cl.bind("<Button-1>", lambda e: self._toggle_overlay())
        mid = tk.Frame(ov, bg=B); mid.pack(fill="x", padx=8, pady=(4, 1)); drag(mid)
        active = self.eng.running; col = A if active else D
        self._ov_dot = tk.Label(mid, text="●", bg=B, fg=col, font=("Consolas", 16)); self._ov_dot.pack(side="left"); drag(self._ov_dot)
        self._ov_lbl = tk.Label(mid, text="FISHING" if active else "OFFLINE", bg=B, fg=col, font=("Consolas", 10, "bold"))
        self._ov_lbl.pack(side="left", padx=(4, 0)); drag(self._ov_lbl)
        self._ov_catch = tk.Label(mid, text=f"🐟 {self._catch_count}", bg=B, fg=self.ACC2, font=("Consolas", 9, "bold"))
        self._ov_catch.pack(side="left", padx=8)
        self._ov_toggle = tk.Button(mid, text="STOP" if active else "START", bg=C if active else A, fg="white",
                                    font=("Consolas", 8, "bold"), relief="flat", padx=10, pady=2, cursor="hand2",
                                    command=self._toggle)
        self._ov_toggle.pack(side="right")
        self._ov_action = tk.Label(ov, text="—", bg=B, fg=D, font=("Consolas", 7), anchor="w", width=38)
        self._ov_action.pack(fill="x", padx=8, pady=(0, 4)); drag(self._ov_action)
        self._overlay = ov; self._overlay_btn.config(bg=self.ACC2)

    def _close(self):
        self.eng.stop()
        try:
            if self._overlay and self._overlay.winfo_exists():
                self.cfg["overlay_x"] = self._overlay.winfo_x(); self.cfg["overlay_y"] = self._overlay.winfo_y()
        except Exception: pass
        save_cfg(self._gather())
        try: keyboard.unhook_all()
        except Exception: pass
        self.destroy(); sys.exit(0)

if __name__ == "__main__":
    App().mainloop()
