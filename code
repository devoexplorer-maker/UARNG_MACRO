        body = tk.Frame(self, bg=self.CARD)
        inner = tk.Frame(body, bg=self.CARD); inner.pack(fill="x", padx=14, pady=8)
        st = {"open": False}
        def toggle(e=None):
            if st["open"]:
                body.pack_forget(); lbl.config(text=f"▶ {title}  (click to expand)")
            else:
                body.pack(fill="x", padx=20, pady=(0, 6), after=hdr); lbl.config(text=f"▼ {title}  (click to collapse)")
            st["open"] = not st["open"]
        lbl.bind("<Button-1>", toggle)
        return inner

    def _build(self):
        B, C, A, A2, F, D = self.BG, self.CARD, self.ACC, self.ACC2, self.FG, self.DIM

        # Header
        hdr = tk.Frame(self, bg=B); hdr.pack(fill="x", padx=20, pady=(14, 0))
        tk.Label(hdr, text="🎣", bg=B, fg=A, font=("Segoe UI Emoji", 16)).pack(side="left")
