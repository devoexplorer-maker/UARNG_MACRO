    def _lbl(self, parent, text, fg=None, size=8, bold=False, bg=None, **kw):
        return tk.Label(parent, text=text, bg=bg or self.CARD, fg=fg or self.DIM,
                        font=("Consolas", size, "bold" if bold else "normal"), **kw)

    def _check(self, parent, text, key, tip=None):
        v = tk.BooleanVar(value=bool(self.cfg.get(key))); self._v[key] = (v, bool)
        cb = tk.Checkbutton(parent, text=text, variable=v, bg=self.CARD, fg=self.DIM, selectcolor=self.ENT,
                            activebackground=self.CARD, font=("Consolas", 8), highlightthickness=0)
        cb.pack(anchor="w")
