                   highlightthickness=1, highlightbackground="#2a2a35").pack(side="left", padx=4)
        if unit: self._lbl(r, unit).pack(side="left")
        if tip: ToolTip(r, tip)

    def _sep(self, parent):
        tk.Frame(parent, bg="#2a2a35", height=1).pack(fill="x", pady=(5, 5))

    def _section(self, title):
        hdr = tk.Frame(self, bg=self.BG); hdr.pack(fill="x", padx=20, pady=(4, 0))
        lbl = self._lbl(hdr, f"▶ {title}  (click to expand)", bold=True, bg=self.BG, cursor="hand2")
