    def _spin(self, parent, text, key, lo, hi, inc, unit="", tip=None, cast=float):
        r = tk.Frame(parent, bg=self.CARD); r.pack(anchor="w", pady=1)
        self._lbl(r, text, width=18, anchor="w").pack(side="left")
        v = tk.StringVar(value=str(self.cfg.get(key, DEFAULTS.get(key)))); self._v[key] = (v, cast)
